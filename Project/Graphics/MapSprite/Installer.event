#include "Internals.event"
//First free SMS is 107
#define Lord 107 
#define GreatLord 108
#define GrandPaladin 109
#define F_Thief 110
#define FTrueblade 111
//First free MMS is 127 and will show up if you've expanded classes.
#define Lord2 127 
#define GreatLord2 128
#define GrandPaladin2 129
#define F_Thief2 130 
#define FTrueblade2 131

 
 
 
 
//Copy from here 
PUSH 
 
SetSMS(0x1, 0, Lord_Data) 
SetMMS(0x1, Lord2_Data, NormalAP) 
SetSMS(0x6B, 1, GrandPaladin_Data) 
SetMMS(0x7F, GrandPaladin2_Data, NormalAP) 
SetSMS(0x3, 1, GreatLord_Data) 
SetMMS(0x3, GreatLord2_Data, RoyLordAP)  
SetSMS(0x6C, 0, F_Thief_Data)
SetMMS(0x80, F_Thief2_Data, NormalAP)
SetSMS(0x6D, 0, FTrueblade_Data)
SetMMS(0x81, FTrueblade2_Data, NormalAP)
POP 
//Copy until here  
 
 
//SMS Image Data 
 
ALIGN 4 
Lord_Data: 
#incbin "dmp/Lord.dmp" 
 
ALIGN 4 
Lord2_Data: 
#incbin "dmp/Lord2.dmp" 

ALIGN 4 
GrandPaladin_Data: 
#incbin "dmp/GrandPaladin.dmp" 

ALIGN 4
GrandPaladin2_Data:
#incbin "dmp/GrandPaladin2.dmp"

ALIGN 4

GreatLord_Data:
#incbin "dmp/GreatLord.dmp"

ALIGN 4
GreatLord2_Data: 
#incbin "dmp/GreatLord2.dmp"
 
ALIGN 4
F_Thief_Data:
#incbin "dmp/F_Thief.dmp"

ALIGN 4
F_Thief2_Data:
#incbin "dmp/F_Thief2.dmp"

ALIGN 4
FTrueblade_Data:
#incbin "dmp/FTrueblade.dmp"

ALIGN 4
